# Salin jadi .env lalu isi bila ingin konek ke Neon/Postgres saat pengembangan lokal.
# Tanpa nilai ini, aplikasi otomatis memakai penyimpanan lokal (localStorage).
# Di Vercel, salin nilai dari integrasi Neon lewat Project Settings > Environment Variables.

DATABASE_URL=postgresql://user:password@host/database

# RAHASIA pembuka kunci pengelola di cloud. WAJIB diset di Vercel
# (Project Settings > Environment Variables). Gunakan nilai acak panjang,
# mis. dari `openssl rand -hex 32`. Jangan commit nilai aslinya ke git.
# Tanpa variabel ini, SEMUA permintaan ubah/hapus/backup/upload akan ditolak (401).
RQ_ADMIN_TOKEN=